root = true

[*.cs]
csharp_style_namespace_declarations = file_scoped:suggestion

# ---------------------------------------------------------------------------
# Naming (root AGENTS.md: PascalCase public, _camelCase private fields)
# ---------------------------------------------------------------------------

# Public / protected symbols (methods, properties, classes, records, events) → PascalCase
dotnet_naming_rule.public_members.symbols = public_symbols
dotnet_naming_rule.public_members.style = pascal_case_style
dotnet_naming_rule.public_members.severity = suggestion

dotnet_naming_symbols.public_symbols.applicable_kinds = class, struct, interface, enum, property, method, field, event, delegate
dotnet_naming_symbols.public_symbols.applicable_accessibilities = public, protected, protected_internal

dotnet_naming_style.pascal_case_style.capitalization = pascal_case

# Private instance fields → _camelCase
dotnet_naming_rule.private_instance_fields.symbols = private_instance_fields
dotnet_naming_rule.private_instance_fields.style = private_camel_case_style
dotnet_naming_rule.private_instance_fields.severity = suggestion

dotnet_naming_symbols.private_instance_fields.applicable_kinds = field
dotnet_naming_symbols.private_instance_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_instance_fields.required_modifiers =

dotnet_naming_style.private_camel_case_style.required_prefix = _
dotnet_naming_style.private_camel_case_style.capitalization = camel_case

# Private constants / static fields → camelCase (no underscore prefix; matches existing code)
dotnet_naming_rule.private_static_fields.symbols = private_static_symbols
dotnet_naming_rule.private_static_fields.style = camel_case_style
dotnet_naming_rule.private_static_fields.severity = suggestion

dotnet_naming_symbols.private_static_symbols.applicable_kinds = field
dotnet_naming_symbols.private_static_symbols.applicable_accessibilities = private
dotnet_naming_symbols.private_static_symbols.required_modifiers = static, const

dotnet_naming_style.camel_case_style.capitalization = camel_case

# Parameters → camelCase
dotnet_naming_rule.parameters.symbols = parameter_symbols
dotnet_naming_rule.parameters.style = camel_case_style
dotnet_naming_rule.parameters.severity = suggestion

dotnet_naming_symbols.parameter_symbols.applicable_kinds = parameter

# ---------------------------------------------------------------------------
# Roslyn analyzer overrides (from ArchitectureReview §2.4 — conservative
# severities so the existing code still builds; ratchet up via CI later).
# ---------------------------------------------------------------------------

# CA1062 Validate arguments of public methods — nullable reference types already
# covers most cases in this codebase; surface as suggestion for new public APIs.
dotnet_diagnostic.CA1062.severity = suggestion

# CA1822 Mark members static — common false positive on MVC controller actions
# (framework calls them via reflection). Suggestion only.
dotnet_diagnostic.CA1822.severity = suggestion

# CA2200 Rethrow to preserve stack details — `throw e;` instead of `throw;`.
# Real bug, never seen in this repo yet. Warning.
dotnet_diagnostic.CA2200.severity = warning

# IDE0060 remove unused parameter — populous noise on controller actions whose
# params are bound by the model binder. Suppress.
dotnet_diagnostic.IDE0060.severity = none

# ---------------------------------------------------------------------------
# Misc style (aligns repo conventions — all `suggestion` so dotnet format
# --verify-no-changes stays non-blocking until CI gates it)
# ---------------------------------------------------------------------------

csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_prefer_braces = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_style_readonly_field = true:warning

[*.{json,cshtml,js,css,html}]
indent_style = space
indent_size = 4

[*.{js,css,html,yml,yaml}]
indent_size = 2

[*.{md}]
trim_trailing_whitespace = true