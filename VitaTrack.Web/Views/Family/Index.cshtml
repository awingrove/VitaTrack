@{
    ViewData["Title"] = "Family Members";
    Layout = "_Layout";
}
@using VitaTrack.Infrastructure.Models
@model IEnumerable<FamilyMember>

<h2>@ViewData["Title"]</h2>

<p><a class="btn btn-success" asp-action="Create">Add New Family Member</a></p>

<table class="table">
    <thead>
        <tr><th>Name</th><th>Display Name</th><th>Avatar URL</th><th>Actions</th></tr>
    </thead>
    <tbody>
    @foreach (var m in Model)
    {
        <tr>
            <td>@m.Name</td>
            <td>@m.DisplayName</td>
            <td>@m.AvatarUrl</td>
            <td>
                <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@m.Id">Edit</a>
                <form asp-action="Delete" asp-route-id="@m.Id" method="post" style="display:inline"
                      data-confirm-message="Delete this family member? Their prescribed doses will also be deleted.">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>

<script src="~/js/delete-confirm.js"></script>
