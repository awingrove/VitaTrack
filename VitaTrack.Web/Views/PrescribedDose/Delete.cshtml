@{
    ViewData["Title"] = "Delete";
    Layout = "_Layout";
}
@using VitaTrack.Infrastructure.Models
@model PrescribedDose

<h2>Delete</h2>

<h3>Are you sure you want to delete this prescribed dose?</h3>
<div>
    <h4>PrescribedDose</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>Family Member</dt>
        <dd>@(Model.FamilyMemberName ?? Model.FamilyMemberId.ToString())</dd>
        <dt>Supplement</dt>
        <dd>@(Model.SupplementName ?? Model.SupplementId.ToString())</dd>
        <dt>Start Date</dt>
        <dd>@(Model.StartDate?.ToShortDateString() ?? "—")</dd>
        <dt>End Date</dt>
        <dd>@(Model.EndDate?.ToShortDateString() ?? "Ongoing")</dd>
        <dt>Dosage</dt>
        <dd>@Model.Dosage</dd>
        <dt>Instructions</dt>
        <dd>@Model.Instructions</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <div class="form-group">
            <input type="submit" value="Delete" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </form>
</div>