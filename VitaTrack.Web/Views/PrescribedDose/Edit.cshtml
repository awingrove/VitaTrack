@{
    ViewData["Title"] = "Edit";
    Layout = "_Layout";
}
@using VitaTrack.Infrastructure.Models
@model PrescribedDose

<h2>Edit</h2>

<form asp-action="Edit">
    <div class="mb-3">
        <input type="hidden" asp-for="Id" />
    </div>
    <div class="mb-3">
        <label asp-for="FamilyMemberId" class="control-label"></label>
        <select asp-for="FamilyMemberId" class="form-control" asp-items="ViewBag.FamilyMemberId">
            <option value="">-- Select Family Member --</option>
        </select>
        <span asp-validation-for="FamilyMemberId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="SupplementId" class="control-label"></label>
        <select asp-for="SupplementId" class="form-control">
            <option value="">-- Select Supplement --</option>
            @foreach (var s in (IEnumerable<Supplement>)ViewData["Supplements"]!)
            {
                @if (string.IsNullOrEmpty(s.Brand))
                {
                    <option value="@s.Id" data-serving="@s.DailyDose">@s.Name</option>
                }
                else
                {
                    <option value="@s.Id" data-serving="@s.DailyDose">@s.Name (@s.Brand)</option>
                }
            }
        </select>
        <span asp-validation-for="SupplementId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="StartDate" class="control-label">Start Date (optional)</label>
        <input asp-for="StartDate" class="form-control" type="date" />
        <span asp-validation-for="StartDate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="EndDate" class="control-label">End Date (optional)</label>
        <input asp-for="EndDate" class="form-control" type="date" />
        <span asp-validation-for="EndDate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="control-label">Serving size</label>
        <p id="ServingSize" class="form-control-plaintext mb-0">—</p>
    </div>
    <div class="mb-3">
        <label asp-for="Multiplier" class="control-label">Multiplier (× serving)</label>
        <div class="input-group multiplier-stepper" data-step="0.25" data-min="0.01">
            <button type="button" class="btn btn-outline-secondary" data-stepper="decrement" aria-label="Decrease multiplier">−</button>
            <input asp-for="Multiplier" class="form-control" type="number" step="any" min="0.01" />
            <button type="button" class="btn btn-outline-secondary" data-stepper="increment" aria-label="Increase multiplier">+</button>
        </div>
        <span asp-validation-for="Multiplier" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Instructions" class="control-label"></label>
        <input asp-for="Instructions" class="form-control" />
        <span asp-validation-for="Instructions" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <input type="submit" value="Save" class="btn btn-primary" />
    </div>
</form>
<script src="~/js/prescribed-dose-serving.js"></script>
<script src="~/js/multiplier-stepper.js"></script>

<div>
    <a asp-action="Index">Back to List</a>
</div>
