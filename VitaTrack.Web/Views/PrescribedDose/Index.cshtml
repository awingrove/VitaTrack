@{
    ViewData["Title"] = "Prescribed Doses";
    Layout = "_Layout";
}
@using VitaTrack.Infrastructure.Models
@model IEnumerable<PrescribedDose>

<h2>@ViewData["Title"]</h2>

<p><a class="btn btn-success" asp-action="Create">Add New Prescribed Dose</a></p>

<table class="table">
    <thead>
        <tr>
            <th>Family Member</th>
            <th>Supplement</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th>Dosage</th>
            <th>Frequency/Day</th>
            <th>Instructions</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var pd in Model)
    {
        <tr>
            <td>@(pd.FamilyMemberName ?? pd.FamilyMemberId.ToString())</td>
            <td>@(pd.SupplementName ?? pd.SupplementId.ToString())</td>
            <td>@(pd.StartDate?.ToShortDateString() ?? "—")</td>
            <td>@(pd.EndDate?.ToShortDateString() ?? "Ongoing")</td>
            <td>@pd.Dosage</td>
            <td>@pd.FrequencyPerDay</td>
            <td>@pd.Instructions</td>
            <td>
                <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@pd.Id">Edit</a>
                <form asp-action="Delete" asp-route-id="@pd.Id" method="post" style="display:inline"
                      data-confirm-message="Delete this prescribed dose?">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>

<script src="~/js/delete-confirm.js"></script>
