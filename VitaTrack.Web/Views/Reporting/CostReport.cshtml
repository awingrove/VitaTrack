@{
    ViewData["Title"] = "Cost Report";
    Layout = "_Layout";
}
@using VitaTrack.Core.Features.Reporting
@model CostReportData

<h2>@ViewData["Title"]</h2>
<p class="text-muted">Report date: @Model.ReportDate.ToString("yyyy-MM-dd")</p>

<h3>Monthly Cost by Supplement</h3>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Supplement</th>
            <th>Brand</th>
            <th>Cost per Serving</th>
            <th>Monthly Cost</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.SupplementCosts)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Brand</td>
            <td>@item.UnitCost</td>
            <td>@item.MonthlyCost</td>
        </tr>
    }
    </tbody>
</table>

<h3>Monthly Cost by Family Member</h3>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Family Member</th>
            <th>Monthly Cost</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.MemberCosts)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.MonthlyCost</td>
        </tr>
    }
    </tbody>
</table>

<h3>Grand Total</h3>
<p class="lead">@Model.GrandTotal</p>
