@{
    ViewData["Title"] = "Daily Nutrient Report";
    Layout = "_Layout";
}
@using System.Text.Json
@model IEnumerable<Supplement>

@{
    var grandTotals = ViewData["GrandTotals"] as string;
    var grandTotalsDict = new Dictionary<string, decimal>();
    if (grandTotals != null)
        grandTotalsDict = JsonSerializer.Deserialize<Dictionary<string, decimal>>(grandTotals) ?? new Dictionary<string, decimal>();

    var memberNames = ViewData["MemberNames"] as string;
    var memberNamesList = new List<string>();
    if (memberNames != null)
        memberNamesList = JsonSerializer.Deserialize<List<string>>(memberNames) ?? new List<string>();

    var memberData = ViewData["MemberData"] as string;
    var memberDataList = new List<Dictionary<string, string>>();
    if (memberData != null)
        memberDataList = JsonSerializer.Deserialize<List<Dictionary<string, string>>>(memberData) ?? new List<Dictionary<string, string>>();

    var totalCost = ViewData["TotalCost"] as string;
    var reportDate = ViewData["ReportDate"] as string;
}

<h2>@ViewData["Title"]</h2>
<p class="text-muted">Report date: @reportDate</p>

@if (grandTotalsDict.Count == 0)
{
    <p class="text-muted">No active prescribed doses found. Add a prescribed dose first.</p>
}
else
{
    <!-- Grand Totals -->
    <h3>Grand Total (All Members)</h3>
    <table class="table">
        <thead>
            <tr><th>Nutrient</th><th>Daily Total</th></tr>
        </thead>
        <tbody>
        @foreach (var kvp in grandTotalsDict.OrderBy(k => k.Key))
        {
            <tr>
                <td>@kvp.Key</td>
                <td>@kvp.Value.ToString("F2")</td>
            </tr>
        }
        </tbody>
    </table>

    <!-- Per-Family-Member Breakdown -->
    <h3>Per Family Member</h3>
    @if (memberNamesList.Count > 0)
    {
        // Collect all unique nutrient names
        var allNutrients = new List<string>();
        foreach (var md in memberDataList)
        {
            foreach (var kvp in md)
            {
                if (!allNutrients.Contains(kvp.Key))
                    allNutrients.Add(kvp.Key);
            }
        }
        allNutrients.Sort();

        <table class="table">
            <thead>
                <tr>
                    <th>Nutrient</th>
                    @foreach (var name in memberNamesList)
                    {
                        <th>@name</th>
                    }
                </tr>
            </thead>
            <tbody>
            @foreach (var nutrient in allNutrients)
            {
                <tr>
                    <td>@nutrient</td>
                    @foreach (var md in memberDataList)
                    {
                        <td>@(md.TryGetValue(nutrient, out var val) ? val : "0.00")</td>
                    }
                </tr>
            }
            </tbody>
        </table>
    }

    <!-- Monthly Cost -->
    <h3>Estimated Monthly Cost</h3>
    <p class="lead">£@totalCost</p>
}

<!-- Supplements Included -->
<h3>Supplements in Report</h3>
<table class="table">
    <thead>
        <tr><th>Name</th><th>Brand</th><th>Serving</th><th>Estimated Monthly Cost</th></tr>
    </thead>
    <tbody>
    @foreach (var s in (IEnumerable<dynamic>)ViewData["SupplementRows"]!)
    {
        <tr>
            <td>@s.Name</td>
            <td>@s.Brand</td>
            <td>@s.DailyDose</td>
            <td>£@s.MonthlyCost</td>
        </tr>
    }
    </tbody>
</table>

<div class="mt-3">
    <a asp-controller="PrescribedDose" asp-action="Index" class="btn btn-outline-info">Manage Prescribed Doses</a>
    <a asp-controller="Supplement" asp-action="Index" class="btn btn-outline-secondary">Browse Supplements</a>
</div>