@* Shared layout – Bootstrap 5 + HTMX *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - VitaTrack</title>

    <!-- Bootstrap 5 (CDN) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- HTMX (CDN) -->
    <script src="https://unpkg.com/htmx.org@1.9.12"></script>

    @RenderSection("Head", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container-fluid">
            <a class="navbar-brand" href="/Home/Index">VitaTrack</a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Family" asp-action="Index">Family</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Supplement" asp-action="Index">Supplements</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="PrescribedDose" asp-action="Index">Doses</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Reporting" asp-action="NutrientReport">Report</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Llm" asp-action="Index">LLM Enrich</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container">
        @RenderBody()
    </main>

    <!-- Bootstrap bundle (includes Popper) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>