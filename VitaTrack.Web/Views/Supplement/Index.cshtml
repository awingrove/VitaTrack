@{
    ViewData["Title"] = "Supplements";
    Layout = "_Layout";
}
@using VitaTrack.Infrastructure.Models
@model IEnumerable<Supplement>

<h2>@ViewData["Title"]</h2>

<p><a class="btn btn-success" asp-action="Create">Add New Supplement</a></p>

<table class="table">
    <thead>
        <tr><th>Name</th><th>Brand</th><th>Serving</th><th>Manufacturer URL</th><th>Cost</th><th>Actions</th></tr>
    </thead>
    <tbody>
    @foreach (var s in Model)
    {
        <tr>
            <td>@s.Name</td>
            <td>@s.Brand</td>
            <td>@s.DailyDose</td>
            <td>@(s.ManufacturerUrl ?? "none")</td>
            <td>@(s.Cost?.ToString("C") ?? "N/A")</td>
            <td>
                <a class="btn btn-sm btn-outline-info" asp-controller="SupplementNutrient" asp-action="Index" asp-route-supplementId="@s.Id">Nutrients</a>
                <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@s.Id">Edit</a>
                <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@s.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>