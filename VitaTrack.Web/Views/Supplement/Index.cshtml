@{
    ViewData["Title"] = "Supplements";
    Layout = "_Layout";
}
@using VitaTrack.Infrastructure.Models
@model IEnumerable<Supplement>

<h2>@ViewData["Title"]</h2>

<p><a class="btn btn-success" asp-action="Create">Add New Supplement</a></p>

<form asp-action="DeleteSelected" method="post" id="delete-selected-form">
    @Html.AntiForgeryToken()

    <button type="submit" class="btn btn-danger mb-3" id="delete-selected-btn" disabled>Delete Selected</button>

    <table class="table">
        <thead>
            <tr>
                <th><input type="checkbox" id="select-all" /></th>
                <th>Name</th>
                <th>Brand</th>
                <th>Serving</th>
                <th>Manufacturer URL</th>
                <th>Cost</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td><input type="checkbox" name="ids" value="@s.Id" class="row-checkbox" /></td>
                <td>@s.Name</td>
                <td>@s.Brand</td>
                <td>@s.DailyDose</td>
                <td>@(s.ManufacturerUrl ?? "none")</td>
                <td>@(s.Cost?.ToString("C") ?? "N/A")</td>
                <td>
                    <a class="btn btn-sm btn-outline-info" asp-controller="SupplementNutrient" asp-action="Index" asp-route-supplementId="@s.Id">Nutrients</a>
                    <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@s.Id">Edit</a>
                    <form asp-action="Delete" asp-route-id="@s.Id" method="post" style="display:inline" onsubmit="return confirm('Delete this supplement?')">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</form>

<script>
    (function () {
        const selectAll = document.getElementById('select-all');
        const checkboxes = document.querySelectorAll('.row-checkbox');
        const deleteBtn = document.getElementById('delete-selected-btn');
        const form = document.getElementById('delete-selected-form');

        function updateDeleteBtn() {
            const anyChecked = document.querySelectorAll('.row-checkbox:checked').length > 0;
            deleteBtn.disabled = !anyChecked;
        }

        selectAll.addEventListener('change', function () {
            checkboxes.forEach(cb => cb.checked = selectAll.checked);
            updateDeleteBtn();
        });

        checkboxes.forEach(cb => cb.addEventListener('change', updateDeleteBtn));

        form.addEventListener('submit', function (e) {
            const checked = document.querySelectorAll('.row-checkbox:checked');
            if (checked.length === 0) {
                e.preventDefault();
                return;
            }
            if (!confirm('Delete ' + checked.length + ' selected supplement(s)?')) {
                e.preventDefault();
            }
        });
    })();
</script>
