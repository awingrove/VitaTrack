@{
    ViewData["Title"] = "Supplements";
    Layout = "_Layout";
}
@using VitaTrack.Infrastructure.Models
@model IEnumerable<Supplement>

<h2>@ViewData["Title"]</h2>

<p>
    <a class="btn btn-success" asp-action="Create">Add New Supplement</a>
    <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#importCsvModal">Import CSV</button>
</p>

<form asp-action="DeleteSelected" method="post" id="delete-selected-form" data-entity-name="supplement">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger mb-3" id="delete-selected-btn" disabled>Delete Selected</button>
</form>

<table class="table">
    <thead>
        <tr>
            <th><input type="checkbox" id="select-all" /></th>
            <th>Name</th>
            <th>Brand</th>
            <th>Serving</th>
            <th>Manufacturer URL</th>
            <th>Cost</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var s in Model)
    {
        <tr>
            <td><input type="checkbox" name="ids" value="@s.Id" class="row-checkbox" form="delete-selected-form" /></td>
            <td>@s.Name</td>
            <td>@s.Brand</td>
            <td>@s.DailyDose</td>
            <td>@(s.ManufacturerUrl ?? "none")</td>
                <td>@(s.Cost.HasValue ? $"£{s.Cost.Value:F2}" : "N/A")</td>
            <td>
                <a class="btn btn-sm btn-outline-info" asp-controller="SupplementNutrient" asp-action="Index" asp-route-supplementId="@s.Id">Nutrients</a>
                <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@s.Id">Edit</a>
                <form asp-action="Delete" asp-route-id="@s.Id" method="post" style="display:inline" onsubmit="return confirm('Delete this supplement?')">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>

<script src="~/js/delete-selected.js"></script>
<script src="~/js/import-csv.js"></script>
<partial name="_ImportModal" />
