@{
    ViewData["Title"] = "Delete Nutrient";
    Layout = "_Layout";
}
@using VitaTrack.Infrastructure.Models
@model SupplementNutrient
@{
    var supplement = ViewData["Supplement"] as Supplement;
}

<h2>Delete Nutrient</h2>
<div class="alert alert-danger">
    Are you sure you want to delete this nutrient from <strong>@supplement?.Name</strong>?
</div>

<dl class="row">
    <dt class="col-sm-3">Generic Name</dt>
    <dd class="col-sm-9">@Model.GenericName</dd>

    <dt class="col-sm-3">Specific Form</dt>
    <dd class="col-sm-9">@Model.SpecificForm</dd>

    <dt class="col-sm-3">Dosage</dt>
    <dd class="col-sm-9">@Model.Dosage</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" name="id" value="@Model.Id" />
    <input type="submit" value="Delete" class="btn btn-danger" />
    <a class="btn btn-secondary" asp-action="Index" asp-route-supplementId="@Model.SupplementId">Cancel</a>
</form>