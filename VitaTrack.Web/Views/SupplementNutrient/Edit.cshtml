@{
    ViewData["Title"] = "Edit Nutrient";
    Layout = "_Layout";
}
@using VitaTrack.Infrastructure.Models
@model SupplementNutrient
@{
    var supplement = ViewData["Supplement"] as Supplement;
}

<h2>Edit Nutrient for @supplement?.Name</h2>

<form asp-action="Edit">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="SupplementId" />

    <div class="mb-3">
        <label asp-for="GenericName" class="control-label">Generic Name</label>
        <input asp-for="GenericName" class="form-control" />
        <span asp-validation-for="GenericName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="SpecificForm" class="control-label">Specific Form</label>
        <input asp-for="SpecificForm" class="form-control" />
        <span asp-validation-for="SpecificForm" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Dosage" class="control-label">Dosage</label>
        <input asp-for="Dosage" class="form-control" />
        <span asp-validation-for="Dosage" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ParentNutrientId" class="control-label">Parent blend</label>
        <select asp-for="ParentNutrientId" class="form-control">
            <option value="">— none —</option>
            @foreach (var opt in (IEnumerable<dynamic>)(ViewData["ParentOptions"] as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>()))
            {
                <option value="@opt.Id">@opt.Name</option>
            }
        </select>
        <span asp-validation-for="ParentNutrientId" class="text-danger"></span>
    </div>
    <div class="mt-3">
        <input type="submit" value="Save" class="btn btn-primary" />
        <a class="btn btn-secondary" asp-action="Index" asp-route-supplementId="@Model.SupplementId">Cancel</a>
    </div>
</form>
<script src="/js/nutrient-form.js"></script>