@{
    ViewData["Title"] = "Supplement Nutrients";
    Layout = "_Layout";
}
@using VitaTrack.Infrastructure.Models
@model IEnumerable<SupplementNutrient>
@{
    var supplement = ViewData["Supplement"] as Supplement;
}

<h2>Nutrients for @supplement?.Name</h2>
<p class="text-muted">Serving: @supplement?.DailyDose | Brand: @supplement?.Brand</p>

<p>
    <a class="btn btn-success" asp-action="Create" asp-route-supplementId="@supplement?.Id">Add Nutrient</a>
    <a class="btn btn-outline-primary" asp-controller="Supplement" asp-action="EditNutrients" asp-route-id="@supplement?.Id">Edit Breakdown (Blends)</a>
    <a class="btn btn-secondary" asp-controller="Supplement" asp-action="Index">Back to Supplements</a>
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">No nutrients defined for this supplement yet.</div>
}
else
{
    <form asp-action="DeleteSelected" asp-route-supplementId="@supplement?.Id" method="post" id="delete-selected-form" data-entity-name="nutrient">
        @Html.AntiForgeryToken()

        <button type="submit" class="btn btn-danger mb-3" id="delete-selected-btn" disabled>Delete Selected</button>

        <table class="table">
            <thead>
                <tr>
                    <th><input type="checkbox" id="select-all" /></th>
                    <th>Generic Name</th>
                    <th>Specific Form</th>
                    <th>Dosage</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            @{
                var allNutrients = Model.ToList();
                var roots = allNutrients.Where(n => n.ParentNutrientId == null).ToList();
                var orphans = allNutrients
                    .Where(n => n.ParentNutrientId != null && roots.All(r => r.Id != n.ParentNutrientId));

                var orderedRows = new List<(SupplementNutrient Nutrient, bool IsChild)>();
                foreach (var root in roots)
                {
                    orderedRows.Add((root, false));
                    foreach (var child in allNutrients.Where(c => c.ParentNutrientId == root.Id))
                    {
                        orderedRows.Add((child, true));
                    }
                }
                foreach (var orphan in orphans)
                {
                    orderedRows.Add((orphan, false));
                }
            }
            @foreach (var (nutrient, isChild) in orderedRows)
            {
                <tr>
                    <td><input type="checkbox" name="ids" value="@nutrient.Id" class="row-checkbox" /></td>
                    <td>
                        @if (isChild)
                        {
                            <span class="text-muted ms-3">&#8627;</span><span class="ms-1">@nutrient.GenericName</span>
                        }
                        else
                        {
                            @nutrient.GenericName
                            if (allNutrients.Any(c => c.ParentNutrientId == nutrient.Id))
                            {
                                <span class="badge bg-info text-dark ms-2">blend</span>
                            }
                        }
                    </td>
                    <td>@nutrient.SpecificForm</td>
                    <td>@nutrient.Dosage</td>
                    <td>
                        <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@nutrient.Id">Edit</a>
                        <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@nutrient.Id">Delete</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </form>
}

<script src="~/js/delete-selected.js"></script>
