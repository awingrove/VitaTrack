<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
    <UserSecretsId>4b4c6791-c1bc-4385-b3fa-fc559aa991cf</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VitaTrack.Core\VitaTrack.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The controller tests build requests that must carry the same wire values
         production reads (ServiceConnectionController.HtmxHeader). A test-side copy of
         a constant keeps passing when production's changes, which is a silent loss of
         coverage; sharing the declaration is the fix. See AGENTS.md directive 6. -->
    <InternalsVisibleTo Include="VitaTrack.Tests" />
  </ItemGroup>

</Project>