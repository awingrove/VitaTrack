<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector>
        <Logger>
          <Uri>urn:codecoverage:coverlet</Uri>
          <Configuration>
            <Format>cobertura</Format>
            <Exclude>[VitaTrack.Web]*,[*.Tests]*,[*.ArchitectureTests]*</Exclude>
            <ExcludeByFile>**/Migrations/**,**/wwwroot/**</ExcludeByFile>
            <SkipAutoProps>true</SkipAutoProps>
          </Configuration>
        </Logger>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>